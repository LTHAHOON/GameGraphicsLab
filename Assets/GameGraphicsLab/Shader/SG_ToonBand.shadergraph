    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\n\tLightDirection = float3(0,0,0);\n\tLightColor = float3(1,1,1);\n#else\n\tLight light = GetMainLight();\n\tLightDirection = light.direction;\n\tLightColor = light.color;\n#endif\n"
}

